# DisasterWatch India Configuration
# Copy this file to .env and adjust as necessary

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database configuration
DATABASE_PATH=data/disasterwatch.db

# Live External Data Sources
# USGS Earthquake Feed (Public, free, no API key required)
USGS_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_EARTHQUAKE_MIN_MAGNITUDE=2.5

# Weather & Flood Risk Feed (Open-Meteo public non-commercial API, no key required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# NASA FIRMS Active Fire API (Optional - requires free MAP_KEY registration)
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Leave empty if not configured; app will show "Fire source not connected yet"
NASA_FIRMS_MAP_KEY=

# Government / Official CAP Alert Feed (Optional - placeholder for official disaster-management feeds)
# Leave empty if not connected; app will show "Official CAP alert feed not connected yet"
OFFICIAL_CAP_FEED_URL=

# Cache configuration (seconds)
CACHE_TTL_SECONDS=300
